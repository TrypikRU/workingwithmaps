# Разное
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Файлы IntelliJ
*.iml
*.ipr
*.iws
.idea/

# Каталог .vscode содержит настройки запуска и задачи VS Code.
# Их может потребоваться хранить в системе контроля версий, поэтому
# правило ниже по умолчанию закомментировано.
#.vscode/

# Файлы Flutter/Dart/Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/audit-flutter-test.log

# Файлы символов для расшифровки стека вызовов
app.*.symbols

# Файлы сопоставления после обфускации
app.*.map.json

# Android Studio размещает результаты сборки здесь
/android/.kotlin/
/android/app/debug
/android/app/profile
/android/app/release

# Локальный тестовый сервер ASP.NET
/backend/.tools/
/backend/.tmp/
/backend/**/bin/
/backend/**/obj/
/backend/**/Data/*.sqlite*

# Локально подготовленные пакеты офлайн-карт
/tools/offline_maps/output/
/tools/offline_maps/__pycache__/
