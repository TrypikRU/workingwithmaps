<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема окна Android при запуске процесса с включённой тёмной темой системы -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Заставка Activity автоматически удаляется после первого кадра движка Flutter -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Тема окна после запуска процесса: задаёт фон при инициализации и работе интерфейса Flutter. Используется начиная со второй версии встраивания Flutter в Android. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
